  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201CHeya, kiddo,\u201D you say. \u201CWhat\u2019s the matter? You look
    like you have seen a ghost!\u201D \u201CThat's because I have seen a ghost,\u201D
    she all but shrieks, like a little banshee. \u201CThis whole house is haunted!\u201D
    Oh shit, here we go again. Olivia was always seeing and hearing things. Monsters
    hiding under her bed and in her closet\u2026 Home intruders creeping through
    the shadows while she was trying to sleep\u2026 It was a whole mess. The kid
    had one hell of an imagination. Still, she could usually be talked down with
    logic, unlike many children her age. \u201CWhat makes you think the house is
    haunted?\u201D You asked patiently. \u201CThere\u2019s some really spooky sounds
    coming from your bedroom!\u201D She cried. You nodded sagely. \u201CI\u2019ll
    go check it out, then.\u201D But before you leave, she grabs your hand. \u201CBe
    careful! Ghosts can be awfully dangerous.\u201D \u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
